> from pydantic import BaseModel
> from typing import Optional, List, Dict, Any
  
  
> class ScriptGenerateRequest(BaseModel):
>     product_info: Dict[str, Any]
>     style: Optional[str] = None
>     video_style: Optional[str] = None
>     target_duration: int = 15
>     selected_materials: List[int] = []
>     mode: str = "auto"  # auto / imitation / template
>     template_id: Optional[int] = None
>     reference_video_id: Optional[int] = None
>     additional_instructions: Optional[str] = None
>     num_variants: int = 1
>     aspect_ratio: str = "9:16"  # 9:16 / 16:9 / 1:1 / 4:3
  
  
> class Scene(BaseModel):
>     id: int
>     order: int
>     description: str
>     narration: str
>     dialogue: Optional[str] = None
>     visual_style: Optional[str] = None
>     camera_movement: Optional[str] = None
>     bgm_type: Optional[str] = None
>     duration: int
>     transition: Optional[str] = None
>     material_slice_ids: Optional[List[int]] = None
  
  
> class ScriptGenerateResponse(BaseModel):
>     success: bool
>     script_id: Optional[int] = None
>     scenes: List[Scene]
>     total_duration: int
>     aspect_ratio: str
>     metadata: Dict[str, Any] = {}
>     error: Optional[str] = None
