> """
> 视频创作状态机 — 7步工作流自动/手动模式
> """
> from enum import Enum
  
  
> class TaskState(str, Enum):
>     CREATED = "CREATED"
>     MATERIAL_EMBED = "MATERIAL_EMBED"
>     MATERIAL_EMBED_DONE = "MATERIAL_EMBED_DONE"
>     QUERY_GENERATE = "QUERY_GENERATE"
>     QUERY_GENERATE_DONE = "QUERY_GENERATE_DONE"
>     MATERIAL_SEARCH = "MATERIAL_SEARCH"
>     MATERIAL_SEARCH_DONE = "MATERIAL_SEARCH_DONE"
>     SCRIPT_GENERATE = "SCRIPT_GENERATE"
>     SCRIPT_GENERATE_DONE = "SCRIPT_GENERATE_DONE"
>     TTS_GENERATE = "TTS_GENERATE"
>     TTS_GENERATE_DONE = "TTS_GENERATE_DONE"
>     VIDEO_GENERATE = "VIDEO_GENERATE"
>     VIDEO_GENERATE_DONE = "VIDEO_GENERATE_DONE"
>     VIDEO_COMPOSE = "VIDEO_COMPOSE"
>     VIDEO_COMPOSE_DONE = "VIDEO_COMPOSE_DONE"
>     EXPORTED = "EXPORTED"
>     FAILED = "FAILED"
  
  
  # 工作流定义：state_name → (workflow_name, output_field)
> WORKFLOW_STEPS = [
>     ("MATERIAL_EMBED", "material-embed", "material_id"),
>     ("QUERY_GENERATE", "query-generate", "product_queries"),
>     ("MATERIAL_SEARCH", "material-search", "embeddings"),
>     ("SCRIPT_GENERATE", "script-generate", "scenes"),
>     ("TTS_GENERATE", "tts-generate", "audio_segments"),
>     ("VIDEO_GENERATE", "video-generate", "video_segments"),
>     ("VIDEO_COMPOSE", "video-compose", "output_url"),
> ]
  
  # 允许用户编辑的中间状态
